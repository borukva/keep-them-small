{
	"schemaVersion": 1,
	"id": "keep-them-small",
	"version": "${version}",
	"name": "Keep Them Small",
	"description": "Prevent your animals from aging by nametagging them to [whatever names you wrote in config]",
	"authors": [
		"Tobzi"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/keep-them-small/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.tobzi.keepthemsmall.KeepThemSmall"
		]
	},
	"mixins": [
		"keep-them-small.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}